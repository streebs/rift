{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rift",
  "version": "0.0.2",
  "identifier": "com.streebs.rift",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rift",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQjgzNDI4RjkzNjJGMUYKUldRZkx6YjVLRFM0bkhjZ2R0VEdPR0J4MVZvQm1EVlBHbDgzNFlvT3hzV21GZmFraUJzR3h2RzMK",
      "endpoints": [
        "https://github.com/streebs/rift/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}